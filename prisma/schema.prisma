// LearnLink Database Schema
// Connected to Neon Serverless PostgreSQL cloud database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           String    @default("STUDENT") // TEACHER | STUDENT | PARENT
  avatar         String?
  phone          String?
  bio            String?
  emailVerified  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  sessions              Session[]
  teacherClasses        Class[]              @relation("TeacherClasses")
  enrollments           Enrollment[]
  parentChildren        ParentChild[]        @relation("ParentRelation")
  childParents          ParentChild[]        @relation("ChildRelation")
  submissions           Submission[]
  gradedSubmissions     Grade[]              @relation("GradedBy")
  attendanceRecords     Attendance[]         @relation("StudentAttendance")
  markedAttendance      Attendance[]         @relation("MarkedBy")
  announcements         Announcement[]
  notifications         Notification[]
  sentMessages          TeacherMessage[]     @relation("SentMessages")
  receivedMessages      TeacherMessage[]     @relation("ReceivedMessages")
  verificationTokens    VerificationToken[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String   // "email_verify" | "password_reset"
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ============================================================
// ACADEMIC STRUCTURE
// ============================================================

model Class {
  id              String      @id @default(cuid())
  name            String
  subject         String
  gradeLevel      String?
  section         String?
  description     String?
  enrollmentCode  String      @unique
  status          String      @default("ACTIVE") // ACTIVE | ARCHIVED
  teacherId       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  teacher       User           @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments   Enrollment[]
  lessons       Lesson[]
  assignments   Assignment[]
  schedules     Schedule[]
  announcements Announcement[]

  @@index([teacherId])
  @@index([enrollmentCode])
}

model Enrollment {
  id         String   @id @default(cuid())
  classId    String
  studentId  String
  status     String   @default("ACTIVE") // ACTIVE | DROPPED | COMPLETED
  enrolledAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model ParentChild {
  id       String   @id @default(cuid())
  parentId String
  childId  String
  status   String   @default("ACTIVE") // PENDING | ACTIVE | REVOKED
  linkedAt DateTime @default(now())

  parent User @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildRelation", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

// ============================================================
// LESSONS & MATERIALS
// ============================================================

model Lesson {
  id          String    @id @default(cuid())
  classId     String
  title       String
  description String?
  content     String?
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  order       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([classId])
  @@index([status])
}

model Material {
  id         String   @id @default(cuid())
  lessonId   String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// ============================================================
// ASSESSMENTS
// ============================================================

model Assignment {
  id               String    @id @default(cuid())
  classId          String
  title            String
  description      String?
  instructions     String?
  type             String    @default("ASSIGNMENT") // ASSIGNMENT | QUIZ
  status           String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  totalPoints      Int       @default(100)
  dueDate          DateTime?
  publishDate      DateTime?
  timeLimitMinutes Int?
  allowLate        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]

  @@index([classId])
  @@index([status])
  @@index([dueDate])
}

model Question {
  id           String   @id @default(cuid())
  assignmentId String
  text         String
  type         String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE | SHORT_ANSWER | ESSAY
  points       Int      @default(1)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  assignment    Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answerChoices AnswerChoice[]
  responses     Response[]

  @@index([assignmentId])
}

model AnswerChoice {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([questionId])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  status       String    @default("DRAFT") // DRAFT | SUBMITTED | LATE | GRADED | RETURNED
  submittedAt  DateTime?
  fileUrl      String?
  fileName     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  responses  Response[]
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model Response {
  id               String  @id @default(cuid())
  submissionId     String
  questionId       String
  answerText       String?
  selectedChoiceId String?

  submission    Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoice AnswerChoice? @relation(fields: [selectedChoiceId], references: [id])

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  score        Float
  maxScore     Float
  percentage   Float
  feedback     String?
  gradedById   String
  gradedAt     DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User       @relation("GradedBy", fields: [gradedById], references: [id])

  @@index([submissionId])
}

// ============================================================
// SCHEDULING & ATTENDANCE
// ============================================================

model Schedule {
  id          String   @id @default(cuid())
  classId     String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  meetingLink String?
  status      String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([classId])
  @@index([startTime])
}

model Attendance {
  id         String   @id @default(cuid())
  scheduleId String
  studentId  String
  status     String   @default("PRESENT") // PRESENT | ABSENT | LATE | EXCUSED
  notes      String?
  markedById String
  markedAt   DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User     @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([scheduleId, studentId])
  @@index([scheduleId])
  @@index([studentId])
}

// ============================================================
// COMMUNICATION
// ============================================================

model Announcement {
  id             String   @id @default(cuid())
  classId        String?
  teacherId      String
  title          String
  message        String
  targetAudience String   @default("all") // all | students | parents
  isPinned       Boolean  @default(false)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id])

  @@index([classId])
  @@index([teacherId])
  @@index([publishedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL") // ANNOUNCEMENT | GRADE_RELEASED | ASSIGNMENT_DUE | ASSIGNMENT_OVERDUE | SCHEDULE_CHANGE | ENROLLMENT | SUBMISSION | FEEDBACK | GENERAL
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model TeacherMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  classId     String?
  subject     String
  message     String
  isRead      Boolean  @default(false)
  sentAt      DateTime @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([sentAt])
}
